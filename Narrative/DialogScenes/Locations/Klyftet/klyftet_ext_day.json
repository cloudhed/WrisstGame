[
    {
        "id": "start_audio",
        "type": "command",
        "command": "@PLAY_MUSIC res://Audio/Music/Klyftet/music_klyftet_exterior.mp3 ; @PLAY_AMBIENCE wind res://Audio/Ambience/Klyftet/klyftet_wind.mp3",
		"clear": false,
        "next": "enter_from_hotbaths"
    },
	{
		"id": "entering_check",
		"type": "logic",
		"logic_type": "check_temp_flags_multi",
		"check_temp_flags": {
			"visiting_hotbaths": "switch_north_intro",
			"visiting_oldmine": "switch_oldmine_intro",
			"visiting_inn": "switch_inn_exterior_intro",
			"default": "enter_first_time"
		}
	},
    {
		"id": "enter_from_hotbaths",
		"type": "logic",
		"check_flags": {
			"flags": ["visiting_hotbaths"],
			"on_success": "switch_north_intro",
			"on_fail": "enter_from_oldmine"
		}
	},
    {
		"id": "enter_from_oldmine",
		"type": "logic",
		"check_flags": {
			"flags": ["visiting_oldmine"],
			"on_success": "switch_oldmine_intro",
			"on_fail": "enter_from_inn"
		}
	},
    {
		"id": "enter_from_inn",
		"type": "logic",
		"check_flags": {
			"flags": ["visiting_inn"],
			"on_success": "switch_inn_exterior_intro",
			"on_fail": "enter_first_time"
		}
	},
    {
		"id": "enter_first_time",
		"type": "logic",
		"check_flags": {
			"flags": ["Entered_Klyftet"],
			"on_success": "south_entrance",
			"on_fail": "intro"
		}
	},
    {
        "id": "intro",
        "type": "narration",
        "text": "You step into Klyftet for the first time.",
		"clear": true,
        "next": "intro_choice_hub"
    },
	{
		"id": "intro_choice_hub",
		"type": "choice",
		"clear": false,
		"options": [
			{
				"text": "> [Go to Market]",
				"next": "switch_market_intro"
			},
			{
				"text": "> [Go to Inn]",
				"next": "switch_inn_exterior_intro"
			},
			{
				"text": "> [Look at Sign]",
				"next": "look_sign"
			},
			{
				"text": "> [Leave]",
				"next": "leave_nocontact_01"
			}
		]
	},
	{
		"id": "south_entrance_setflag",
		"type": "logic",
		"set_flag": "Entered_Klyftet",
		"flag_type": "event",
        "next": "intro_choice_hub"
	},
	{
		"id": "south_entrance",
		"type": "choice",
		"clear": true,
		"options": [
			{
				"text": "> [Go to Market]",
				"next": "switch_market_intro"
			},
			{
				"text": "> [Go to Inn]",
				"next": "switch_inn_exterior_intro"
			},
			{
				"text": "> [Look at Sign]",
				"next": "look_sign"
			},
			{
				"text": "> [Leave]",
				"next": "leave_nocontact_01"
			}
		]
	},
    {
        "id": "leave_nocontact_01",
        "type": "narration",
        "text": "You once again step out in the wilderness.",
		"command": "@FADE_MUSIC_OUT ; @STOP_ALL_AMBIENCE",
		"clear": true,
        "next": "leave_nocontact_end"
    },
	{
		"id": "leave_nocontact_end",
		"type": "command",
		"command": "@LEAVE_ENCOUNTER",
        "next": "klyftet_end"
	},
	{
		"id": "klyftet_end",
		"type": "command",
		"command": "@LEAVE_ENCOUNTER",
		"end": true
	},
    {
        "id": "look_sign",
        "type": "narration",
        "text": "The crude stone sign is painted with a rust-red color: [b]KLYFTET[/b], probably the name of the town.",
		"clear": true,
        "next": "intro_choice_hub"
    },
	{
		"id": "look_lanterna_CHECK",
		"type": "logic",
		"check_flags": {
			"flags": ["knows_lanterna_json"],
			"on_success": "look_lanterna",
			"on_fail": "look_lanterna_unknown"
		}
	},
    {
        "id": "look_lanterna",
        "type": "narration",
        "text": "The familiar lanterna greets you with its green glow.",
		"clear": true,
        "next": "intro_choice_hub"
    },
    {
        "id": "look_lanterna_unknown",
        "type": "narration",
        "text": "The strange lamp post is glowing with a green light, and seems to be emitting some sort of green fog.",
		"clear": true,
		"set_flag": "knows_lanterna_json",
		"flag_type": "dialog",
        "next": "intro_choice_hub"
    },
    {
        "id": "market_intro",
        "type": "narration",
        "text": "The bustling market full of different kinds of Monsterfolk makes you nervous. Better to stay away for now until you've found your footing in this strange world.",
		"clear": true,
        "next": "market_choice"
    },
	{
		"id": "market_choice",
		"type": "choice",
		"clear": true,
		"options": [
			{
				"text": "> Buy",
				"next": "market_BARTER"
			},
			{
				"text": "> [DEBUG] +128 all currency",
				"next": "debug_add_currency"
			},
			{
				"text": "> [Leave]",
				"next": "leave_nocontact_01"
			}
		]
	},
	{
		"id": "debug_add_currency",
		"type": "command",
		"command": "@add_ore 128 ; @add_crowns 2 ; @add_drots 1 ; @add_item Misc/creature_loot 6 ; @add_item Misc/slime_glob 13 ; @add_item Misc/whisker_needle 111",
		"next": "market_choice"
	},
    {
        "id": "market_BARTER",
        "type": "command",
        "command": "@OPEN_BARTER res://Resources/Shops/Klyftet/klyftet_market_shop.tres",
		"clear": true,
        "next": "market_choice"
    },

    {
        "id": "switch_inn_exterior_intro",
        "type": "command",
        "command": "@SHOW_ZONE Klyftet/KlyftetExtInnDay",
		"clear": true,
        "next": "inn_exterior_intro"
    },
    {
        "id": "switch_southentrance_intro",
        "type": "command",
        "command": "@SHOW_ZONE Klyftet/KlyftetExtSouthDay ; @STOP_AMBIENCE lake",
		"clear": true,
        "next": "intro_choice_hub"
    },
    {
        "id": "inn_exterior_intro",
        "type": "narration",
        "text": "You're standing in front of a large inn.",
		"clear_flag": ["visiting_hotbaths", "visiting_oldmine", "visiting_inn"],
		"clear": false,
        "next": "intro_inn_choice_hub"
    },
	{
		"id": "intro_inn_choice_hub",
		"type": "choice",
		"options": [
			{
				"text": "> [Go inside] [Normal conditional]",
				"next": "enter_inn"
			},
			{
				"text": "> [Go inside] [DEBUG Night]",
				"next": "enter_inn_DEBUG_night"
			},
			{
				"text": "> [Go Sewers] [DEBUG]",
				"next": "enter_sewers_pre"
			},
			{
				"text": "> [Go to Alley]",
				"next": "switch_inn_alley_intro"
			},
			{
				"text": "> [Go back to South Entrance]",
				"next": "switch_southentrance_intro"
			}
		]
	},
    {
        "id": "enter_inn",
        "type": "command",
        "command": "@LOCATION_CHANGE inn ; @FADE_MUSIC_OUT ; @STOP_ALL_AMBIENCE",
		"clear": true,
        "next": "intro_choice_hub"
    },
    {
        "id": "enter_inn_DEBUG_night",
        "type": "command",
        "command": "@SET_TIME night",
		"clear": true,
        "next": "enter_inn"
    },
    {
        "id": "whereto_debug",
        "type": "narration",
        "text": "Where should we go?",
		"clear": false,
		"next": "whereto_debug_choice"
    },
	{
		"id": "whereto_debug_choice",
		"type": "choice",
		"options": [
			{
				"text": "> [?]",
				"next": "whereto_debug"
			}
		]
	},
	{
		"id": "switch_inn_alley_intro_check",
		"type": "logic",
		"check_flags": {
			"flags": ["alley_grate_opened", "alley_bothered_smoke"],
			"on_success": "inn_alley_intro_choice",
			"on_fail": "switch_inn_alley_intro"
		}
	},
    {
        "id": "switch_inn_alley_intro",
        "type": "command",
		"name": "grate",
        "command": "@SHOW_ZONE Klyftet/KlyftetExtInnAlleyDay ; @SHOW_EXTRA closed",
		"clear": true,
        "next": "inn_alley_intro_show_portrait"
    },
    {
        "id": "inn_alley_intro_show_portrait",
        "type": "command",
		"name": "Pichidi",
        "command": "@SHOW_PORTRAIT smoke1",
		"clear": true,
        "next": "inn_alley_intro_choice"
    },
	{
		"id": "inn_alley_intro_choice",
		"type": "choice",
		"options": [
			{
				"text": "> [Open grate]",
				"next": "alley_open_grate_flags",
				"hide_if": { "has_flag": "alley_grate_opened" }
			},
			{
				"text": "> [Bother smoke]",
				"next": "alley_bother_smoke_flagset",
				"hide_if": { "has_flag": "alley_bothered_smoke" }
			},
			{
				"text": "> [Enter the hole]",
				"next": "alley_enter_sewers_flagset",
				"show_if": { "has_flag": ["alley_grate_opened", "alley_bothered_smoke"] }
			},
			{
				"text": "> [Go back to Inn]",
				"next": "switch_inn_exterior_intro_hide_portrait"
			}
		]
	},

	{
		"id": "alley_enter_sewers_flagset",
		"type": "logic",
		"set_flag": "entered_sewer_from_alley",
		"flag_type": "event",
		"next": "enter_sewers_pre"
	},
	{
		"id": "enter_sewers_pre",
		"type": "narration",
		"text": "You climb down into the hole.",
		"clear": true,
		"next": "enter_sewers"
	},
	{
		"id": "enter_sewers",
		"type": "command",
        "command": "@LOCATION_CHANGE sewers ; @FADE_MUSIC_OUT ; @STOP_ALL_AMBIENCE",
		"clear": true,
        "next": "intro_choice_hub"
	},

    {
        "id": "switch_inn_exterior_intro_hide_portrait",
        "type": "command",
        "command": "@HIDE_PORTRAIT ; HIDE_EXTRA",
		"clear": true,
        "next": "switch_inn_exterior_intro"
    },
	{
		"id": "alley_open_grate_flags",
		"type": "logic",
		"set_flag": "alley_grate_opened",
		"flag_type": "event",
		"next": "alley_open_grate"
    },
    {
        "id": "alley_open_grate",
        "type": "npc",
		"name": "grate",
        "command": "@SHOW_EXTRA open",
		"text": "You open the grate, revealing a dark hole leading down into the ground. A foul stench wafts up from the hole.",
        "next": "inn_alley_intro_choice"
    },
	{
		"id": "alley_bother_smoke_flagset",
		"type": "logic",
		"set_flag": "alley_bothered_smoke",
		"flag_type": "event",
		"next": "alley_smoke_animation"
	},
    {
        "id": "alley_smoke_animation",
        "type": "command",
		"name": "Pichidi",
        "command": "@SHOW_PORTRAIT smoke2",
        "next": "alley_smoke_animation2"
    },
    {
        "id": "alley_smoke_animation2",
        "type": "command",
		"name": "Pichidi",
        "command": "@SHOW_PORTRAIT smoke3",
        "next": "alley_smoke_animation3"
    },
    {
        "id": "alley_smoke_animation3",
        "type": "command",
		"name": "Pichidi",
        "command": "@SHOW_PORTRAIT smoke4",
        "next": "alley_smoke_animation4"
    },
    {
        "id": "alley_smoke_animation4",
        "type": "command",
		"name": "Pichidi",
        "command": "@HIDE_PORTRAIT",
        "next": "inn_alley_intro_choice"
    },


    {
        "id": "switch_lakeside_intro",
        "type": "command",
        "command": "@SHOW_ZONE Klyftet/KlyftetExtLakesideDay ; @PLAY_AMBIENCE lake res://Audio/Ambience/Klyftet/lake_waves.mp3",
		"clear": true,
        "next": "whereto_debug"
    },
    {
        "id": "switch_north_intro",
        "type": "command",
        "command": "@SHOW_ZONE Klyftet/KlyftetExtNorthDay",
		"clear_flag": ["visiting_hotbaths", "visiting_oldmine"],
		"clear": true,
        "next": "whereto_debug"
    },
    {
        "id": "switch_hotbaths_ext_intro",
        "type": "command",
        "command": "@SHOW_ZONE Klyftet/KlyftetExtHotbathsDay",
		"clear_flag": ["visiting_hotbaths"],
		"clear": true,
        "next": "whereto_debug"
    },
    {
        "id": "switch_oldmine_intro",
        "type": "command",
        "command": "@SHOW_ZONE Klyftet/KlyftetExtOldmineDay",
		"clear_flag": ["visiting_oldmine"],
		"clear": true,
        "next": "whereto_debug"
    },
    {
        "id": "switch_market_intro",
        "type": "command",
        "command": "@SHOW_ZONE Klyftet/KlyftetExtMarketDay",
		"clear_flag": ["visiting_hotbaths", "visiting_oldmine"],
		"clear": true,
        "next": "market_intro"
    },
    {
        "id": "fade_audio",
        "type": "command",
        "command": "@FADE_MUSIC_OUT ; @STOP_ALL_AMBIENCE",
		"clear": true,
        "next": "whereto_debug"
    }
]