script = ExtResource("1_7cjin")
messages = Array[String](["You clumsily wave your fists around, hitting only air. But hey, at least the air has learned not to pick a fight with you, huh?", "You hit the... no, wait, you don't. [i]Wow.[/i] Not your day.", "You miss. Spectacularly.", "You nearly hit yourself. Bold move.", "The [b]{target_name}[/b] watches in confusion as you punch a tree instead."])
