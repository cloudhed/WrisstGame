; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wrisst_test"
run/main_scene="uid://xyxvn2yghvwa"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Manager="*res://Code/manager.tscn"
Events="*res://global/events.gd"
DebugPanel="*res://global/debug_panel.tscn"
Shaker="*res://global/shaker.gd"
GameState="*res://global/gamestate.gd"
DialogSceneSelector="*res://global/dialog_scene_selector.gd"
PileManager="*res://global/pile_manager.gd"
GameUI="*res://Scenes/UI/GameUI.tscn"
MusicPlayer="*res://Assets/Sprites/Particles/music_player.tscn"
SFXPlayer="*res://global/sfx_player.tscn"
AmbiencePlayer="*res://global/ambience_player.tscn"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={
"timeline_base": "res://Timelines/timeline_base.dtl"
}
glossary/default_case_sensitive=true
layout/style_list=["res://Themes/Dialogic Styles/Main Style.tres", "res://Themes/Dialogic Styles/Speech Style.tres"]
layout/default_style="res://Themes/Dialogic Styles/Main Style.tres"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.02
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=false
choices/delay=0.2
choices/reveal_delay=1.0
choices/reveal_by_input=true
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
animations/join_default="Fade In"
animations/leave_default="Fade Out"
animations/cross_fade_default="Fade Cross"
variables={}
text/split_at_new_lines_as=1
text/input_action="dialogic_default_action"
text/split_at_new_lines=false
audio/type_sound_bus="sfx"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[editor]

movie_writer/mjpeg_quality=1.0
movie_writer/movie_file="D:/Media/Game Videos/Wrisst/wrisst.avi"
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray()

[inkgd]

register_templates=true

